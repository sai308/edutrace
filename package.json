{
    "name": "edutrace",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "prebuild": "node scripts/check-icons.js",
        "build": "vue-tsc -b && vite build",
        "check": "vue-tsc --noEmit",
        "type-check": "vue-tsc --noEmit",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "pwa:icons": "pwa-assets-generator --config pwa-assets.config.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
        "prepare": "husky"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/vue-table": "^8.21.3",
        "@unovis/ts": "^1.6.2",
        "@unovis/vue": "^1.6.2",
        "@vueuse/core": "^14.1.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "comlink": "^4.4.2",
        "date-fns": "^4.1.0",
        "docx-preview": "^0.3.7",
        "docxtemplater": "^3.68.3",
        "idb": "^8.0.3",
        "lucide-vue-next": "^0.562.0",
        "papaparse": "^5.5.3",
        "pizzip": "^3.2.0",
        "qrcode": "^1.5.4",
        "reka-ui": "^2.7.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "uuid": "^13.0.0",
        "vite-plugin-pwa": "^1.2.0",
        "vue": "^3.5.24",
        "vue-i18n": "^11.2.7",
        "vue-router": "^4.6.4",
        "workbox-window": "^7.4.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^8.2.0",
        "@iconify-json/radix-icons": "^1.2.6",
        "@iconify/vue": "^5.0.0",
        "@types/node": "^24.10.1",
        "@types/qrcode": "^1.5.6",
        "@upstash/context7-mcp": "2.1.4",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-basic-ssl": "2.3.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitest/coverage-v8": "^4.0.16",
        "@vitest/ui": "^4.0.16",
        "@vue/tsconfig": "^0.8.1",
        "eslint": "^10.2.0",
        "eslint-plugin-format": "^2.0.1",
        "fake-indexeddb": "^6.2.5",
        "husky": "^9.1.7",
        "jsdom": "^27.4.0",
        "lint-staged": "^16.4.0",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vite-plugin-qrcode": "0.4.1",
        "vitest": "^4.0.16",
        "vue-tsc": "^3.1.4",
        "wrangler": "^4.85.0"
    },
    "lint-staged": {
        "src/**/*.{ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "src/**/*.css": [
            "prettier --write"
        ]
    }
}
